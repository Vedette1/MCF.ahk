                        arr.Push(StrGet(pResult, "CP0"))
                        DllCall("msvcrt\free", "Ptr", pResult, "Cdecl")
                    } else {
                        arr.Push(sym)
                    }
                } else {
                    arr.Push(sym)
                }
            }
            return arr
            
        } else if (symbols is String) {
            if (!InStr(symbols, "?") && InStr(symbols, "_Z")) {
