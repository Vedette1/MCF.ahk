    static GetSymbols(symbols) {
        arr := []
        if (symbols is Array) {
            for sym in symbols {
                if (!InStr(sym, "?") && InStr(sym, "_Z")) {
                    actualSym := (InStr(sym, "__Z") == 1) ? SubStr(sym, 2) : sym
                    pResult := DllCall(this.ptr, "AStr", actualSym, "Ptr", 0, "Ptr", 0, "Int*", &status := 0, "Cdecl Ptr")

